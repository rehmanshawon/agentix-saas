# =============================================================================
# Agentix SaaS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control!
# =============================================================================

# --- Node Environment ---
NODE_ENV=development

# --- Database (MySQL) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:password@127.0.0.1:3307/agentix"

# --- NestJS API ---
PORT=3001

# --- OpenAI (Required for AI features) ---
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- Pinecone (Required for vector search / RAG) ---
# Get your API key at: https://app.pinecone.io
# Create an index first, then put its name here
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=agentix-index

# --- NextAuth (Authentication) ---
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (Optional — leave empty to disable) ---
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (Billing) ---
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...

# --- App URLs (Frontend) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000

# --- Seed Script (Optional) ---
# Used by `pnpm db:seed` to create a demo user
SEED_EMAIL=admin@agentix.com
SEED_PASSWORD=password
SEED_WORKSPACE_NAME=Agentix Demo
SEED_AGENT_NAME=SupportBot
# =============================================================================
# Agentix SaaS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control!
# =============================================================================

# --- Node Environment ---
NODE_ENV=development

# --- Database (MySQL) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:password@127.0.0.1:3307/agentix"

# --- NestJS API ---
PORT=3001

# --- AI Provider Routing ---
# Customers do not see provider/model names. DeepSeek is the default chat
# provider for affordable replies; OpenAI remains available as fallback.
DEFAULT_AI_PROVIDER=deepseek
FALLBACK_AI_PROVIDER=openai

# --- DeepSeek Chat (Default for chatbot replies) ---
DEEPSEEK_API_KEY=sk-0ce249c6347449c5922791fe017ce2cd
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# --- OpenAI Fallback + Embeddings ---
# OpenAI is still required for the current Pinecone embedding pipeline.
OPENAI_API_KEY=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
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Pinecone (Required for vector search / RAG) ---
# Get your API key at: https://app.pinecone.io
# Create an index first, then put its name here
PINECONE_API_KEY=pcsk_3v6xHh_B663Cicxati7aCq66yCNdNijNdes9UxDEbho2ZKJWNgR7n4WUtMwdzN2xbtFN3v
PINECONE_INDEX_NAME=agentix-index

# --- NextAuth (Authentication) ---
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (Optional — leave empty to disable) ---
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (Billing) ---
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_STARTER_YEARLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_GROWTH_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_GROWTH_YEARLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_BUSINESS_YEARLY_PRICE_ID=price_...

# --- Billing Provider ---
# Use "stripe" where Stripe is available, or "paddle" for Paddle checkout.
NEXT_PUBLIC_BILLING_PROVIDER=paddle

# --- Paddle Billing ---
# Paddle can be used for global card payments when Stripe is not available.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=pdl_...
PADDLE_WEBHOOK_SECRET=...
PADDLE_CHECKOUT_BASE_URL=http://localhost:3000/checkout/paddle
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_...
NEXT_PUBLIC_PADDLE_STARTER_MONTHLY_PRICE_ID=pri_...
NEXT_PUBLIC_PADDLE_STARTER_YEARLY_PRICE_ID=pri_...
NEXT_PUBLIC_PADDLE_GROWTH_MONTHLY_PRICE_ID=pri_...
NEXT_PUBLIC_PADDLE_GROWTH_YEARLY_PRICE_ID=pri_...
NEXT_PUBLIC_PADDLE_BUSINESS_MONTHLY_PRICE_ID=pri_...
NEXT_PUBLIC_PADDLE_BUSINESS_YEARLY_PRICE_ID=pri_...

# --- App URLs (Frontend) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000

# --- Seed Script (Optional) ---
# Used by `pnpm db:seed` to create a demo user
SEED_EMAIL=admin@agentix.com
SEED_PASSWORD=password
SEED_WORKSPACE_NAME=Agentix Demo
SEED_AGENT_NAME=SupportBot
